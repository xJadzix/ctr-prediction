# ===== DANE =====
# Nigdy nie commitujemy danych - są za duże i powinny być z innego źródła
data/raw/*
data/interim/*
data/processed/*
# Ale zachowujemy strukturę folderów przez .gitkeep
!data/raw/.gitkeep
!data/interim/.gitkeep
!data/processed/.gitkeep

# ===== MODELE =====
# Wytrenowane modele są duże i nie powinny być w repo
# Generic ML model files - ignore everywhere except those explicitly allowed above
*.pkl
*.joblib
*.h5
*.pt
*.pth
*.onnx
# Models folder - ignore by default, except production models (keep those in repo)
models/*
!models/.gitkeep
!models/lightgbm_final.txt
!models/ordinal_encoder.pkl
!models/isotonic_calibrator.pkl


# ===== WYGENEROWANE RAPORTY =====
reports/figures/*
!reports/figures/.gitkeep

# ===== PYTHON =====
# Skompilowany bytecode i cache
__pycache__/
*.py[cod]
*$py.class
*.so

# Dystrybucja i instalacja
.Python
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
*.egg-info/
.installed.cfg
*.egg

# ===== ŚRODOWISKA WIRTUALNE =====
# Środowiska nie są częścią kodu - każdy ma swoje lokalnie
.venv/
venv/
env/
ENV/
.conda/

# ===== JUPYTER =====
# Checkpointy Jupytera (automatyczne kopie zapasowe)
.ipynb_checkpoints/
*/.ipynb_checkpoints/*

# ===== IDE =====
# VS Code - częściowo ignorujemy (indywidualne ustawienia)
.vscode/*
!.vscode/settings.json
!.vscode/extensions.json
# PyCharm
.idea/
# Spyder
.spyderproject
.spyproject

# ===== SYSTEM OPERACYJNY =====
# Windows
Thumbs.db
Desktop.ini
# macOS
.DS_Store
# Linux
*~

# ===== LOGI I TYMCZASOWE =====
*.log
*.tmp
*.bak
*.swp

# ===== ZMIENNE ŚRODOWISKOWE I SEKRETY =====
# NIGDY nie commitujemy plików .env z sekretami
.env
.env.local
.env.*.local
*.pem
*.key
!*.pub

# ===== NARZĘDZIA ANALIZY =====
# Coverage, pytest, mypy
.coverage
.coverage.*
htmlcov/
.pytest_cache/
.mypy_cache/
.ruff_cache/

notebooks/04-5_lightgbm_test.ipynb
notebooks/06_5_calibration_tests.ipynb